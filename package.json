{
  "name": "briefstamp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && vite build --ssr scripts/prerender-landing.tsx --target node22 --outDir dist-prerender && node dist-prerender/prerender-landing.js && vite build --ssr server/gemma-workflow-child.ts --outDir dist-worker && vite build --ssr server/mastra-evidence-child.ts --outDir dist-agent-worker",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "vitest run --no-file-parallelism",
    "audit:sample": "tsx scripts/audit-sample.ts",
    "audit:plan": "tsx scripts/audit-plan.ts",
    "verify": "npm run test && npm run build && npm run audit:sample",
    "verify:orchestration": "tsx scripts/verify-orchestration.ts",
    "verify:temporal": "tsx scripts/verify-temporal.ts",
    "temporal:worker": "tsx scripts/temporal-worker.ts",
    "verify:optional": "tsx scripts/verify-optional-providers.ts"
  },
  "dependencies": {
    "@mastra/core": "1.77.0",
    "@sentry/node": "11.7.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "pg": "^8.13.0",
    "playwright": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
