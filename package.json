{
  "name": "flowproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "vitest run --no-file-parallelism",
    "audit:sample": "tsx scripts/audit-sample.ts",
    "audit:plan": "tsx scripts/audit-plan.ts",
    "verify": "npm run test && npm run build && npm run audit:sample"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "pg": "^8.13.0",
    "playwright": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
