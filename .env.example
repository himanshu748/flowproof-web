# No paid provider calls are enabled by default.
PORT=4310
FLOWPROOF_PUBLIC=false
# Public sample-only visitor sessions; ignores private storage and models.
FLOWPROOF_DEMO=false
# Required for public operator mode (demo=false), use a unique random value of at least 32 characters.
FLOWPROOF_TOKEN=
# Optional local PostgreSQL or Tiger Data connection. TLS verification stays enabled.
DATABASE_URL=
# Set false ONLY for a trusted local PostgreSQL service.
DATABASE_SSL=true
# Optional public CA obtained from an authenticated provider source.
# Supply one PEM file (or inline DATABASE_CA_CERT), plus its confirmed DER SHA-256.
DATABASE_CA_CERT_FILE=
DATABASE_CA_CERT_SHA256=
FLOWPROOF_AI_ENABLED=false
FLOWPROOF_OLLAMA_URL=http://127.0.0.1:11434
FLOWPROOF_OLLAMA_MODEL=qwen3.5:4b
FLOWPROOF_GEMMA_ENABLED=false
FLOWPROOF_GEMMA_MODEL=gemma3:4b
FLOWPROOF_EMBEDDINGS=false
OLLAMA_URL=http://127.0.0.1:11434
FLOWPROOF_EMBEDDING_MODEL=all-minilm:22m
