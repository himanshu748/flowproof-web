# No paid provider calls are enabled by default.
PORT=4310
FLOWPROOF_PUBLIC=false
# Public sample-only visitor sessions; ignores private storage and models.
FLOWPROOF_DEMO=false
# Required for public operator mode (demo=false), use a unique random value of at least 32 characters.
FLOWPROOF_TOKEN=
# Optional local PostgreSQL or Tiger Data connection. TLS verification stays enabled.
DATABASE_URL=
# Set false ONLY for a trusted local PostgreSQL service.
DATABASE_SSL=true
# Optional public CA obtained from an authenticated provider source.
# Supply one PEM file (or inline DATABASE_CA_CERT), plus its confirmed DER SHA-256.
DATABASE_CA_CERT_FILE=
DATABASE_CA_CERT_SHA256=
FLOWPROOF_AI_ENABLED=false
FLOWPROOF_OLLAMA_URL=http://127.0.0.1:11434
FLOWPROOF_OLLAMA_MODEL=qwen3.5:4b
FLOWPROOF_GEMMA_ENABLED=false
FLOWPROOF_GEMMA_MODEL=gemma3:4b
FLOWPROOF_EMBEDDINGS=false
OLLAMA_URL=http://127.0.0.1:11434
FLOWPROOF_EMBEDDING_MODEL=all-minilm:22m
# Real Mastra SDK orchestration is local and makes no model calls on its own.
# Tinker operator checkpoint inference (never enabled in the public sample).
BRIEFSTAMP_TINKER_ENABLED=false
TINKER_API_KEY=
# A current sampler checkpoint; the historical experiment's checkpoints expired.
TINKER_MODEL_PATH=
# Absolute path to fresh, account-bound no-overage allowance evidence.
# See docs/OPTIONAL_PROVIDERS.md. Never commit credentials or allowance files.
BRIEFSTAMP_PROVIDER_ALLOWANCE_FILE=
BRIEFSTAMP_BACKBOARD_ENABLED=false
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
BRIEFSTAMP_SERPAPI_ENABLED=false
SERPAPI_API_KEY=
BRIEFSTAMP_SEARCH_DOMAINS=
BRIEFSTAMP_ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
BRIEFSTAMP_ELEVENLABS_NONCOMMERCIAL_DEMO=false
# Sentry is disabled unless a fresh free allowance is explicitly confirmed.
FLOWPROOF_SENTRY_ENABLED=false
FLOWPROOF_SENTRY_FREE_CONFIRMED=false
FLOWPROOF_SENTRY_FREE_CONFIRMED_AT=
SENTRY_DSN=
# Local durable audits require a separately running Temporal server and worker.
FLOWPROOF_TEMPORAL_ENABLED=false
FLOWPROOF_TEMPORAL_ADDRESS=127.0.0.1:7233
FLOWPROOF_TEMPORAL_RECEIPT_ROOT=
